# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=sidereport
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=sidereport_db
POSTGRES_PORT=5432

# ─── ASP.NET Core ─────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000

# Connection string built from the above PostgreSQL vars
CONNECTION_STRING=Host=db;Port=5432;Database=sidereport_db;Username=sidereport;Password=changeme_strong_password

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_at_least_32_chars_long_secret_key_here!
JWT_ISSUER=SideReport
JWT_AUDIENCE=SideReportUsers
JWT_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=7

# ─── Next.js ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# ─── Storage (Sprint 2 — OCR images) ──────────────────────────────────────────
# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=sidereport-ocr-images

# AWS S3 (alternative)
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET_NAME=sidereport-ocr-images
